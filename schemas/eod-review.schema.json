{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured EOD Shadow review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_date",
    "timestamp",
    "symbol_bars",
    "decision_reviews",
    "benchmark_closes",
    "robinhood_tool_call_count",
    "errors"
  ],
  "properties": {
    "session_date": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "symbol_bars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "bars"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "bars": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/bar"
            }
          }
        }
      }
    },
    "decision_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "decision_timestamp",
          "classification",
          "subsequent_mfe_percent",
          "subsequent_mae_percent",
          "later_material_setup",
          "analysis"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "decision_timestamp": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "GOOD_AVOIDANCE",
              "MISSED_LATER_SETUP",
              "POSSIBLY_OVER_CONSERVATIVE",
              "INCONCLUSIVE"
            ]
          },
          "subsequent_mfe_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "subsequent_mae_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "later_material_setup": {
            "type": "boolean"
          },
          "analysis": {
            "type": "string"
          }
        }
      }
    },
    "benchmark_closes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SPY",
        "QQQ"
      ],
      "properties": {
        "SPY": {
          "type": [
            "number",
            "null"
          ]
        },
        "QQQ": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "robinhood_tool_call_count": {
      "type": "integer"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "complete"
      ],
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "open": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "close": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "complete": {
          "type": "boolean"
        }
      }
    }
  }
}
