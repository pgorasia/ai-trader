{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured EOD Shadow review",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_date", "timestamp", "symbol_bars", "decision_reviews", "benchmark_closes", "robinhood_tool_call_count", "errors"],
  "properties": {
    "session_date": {"type": "string", "format": "date"},
    "timestamp": {"type": "string", "format": "date-time"},
    "symbol_bars": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/$defs/bar"}}},
    "decision_reviews": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symbol", "decision_timestamp", "classification", "subsequent_mfe_percent", "subsequent_mae_percent", "later_material_setup", "analysis"],
        "properties": {
          "symbol": {"type": "string", "pattern": "^[A-Z.\\-]{1,10}$"},
          "decision_timestamp": {"type": "string", "format": "date-time"},
          "classification": {"enum": ["GOOD_AVOIDANCE", "MISSED_LATER_SETUP", "POSSIBLY_OVER_CONSERVATIVE", "INCONCLUSIVE"]},
          "subsequent_mfe_percent": {"type": ["number", "null"]},
          "subsequent_mae_percent": {"type": ["number", "null"]},
          "later_material_setup": {"type": "boolean"},
          "analysis": {"type": "string", "minLength": 1}
        }
      }
    },
    "benchmark_closes": {
      "type": "object", "additionalProperties": false,
      "required": ["SPY", "QQQ"],
      "properties": {
        "SPY": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "QQQ": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "robinhood_tool_call_count": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "bar": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "open", "high", "low", "close", "volume", "complete"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "open": {"type": "number", "exclusiveMinimum": 0}, "high": {"type": "number", "exclusiveMinimum": 0},
        "low": {"type": "number", "exclusiveMinimum": 0}, "close": {"type": "number", "exclusiveMinimum": 0},
        "volume": {"type": "number", "minimum": 0}, "complete": {"type": "boolean"}
      }
    }
  }
}
