{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ephemeral live acceptance account identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "account_contexts", "errors"],
  "properties": {
    "passed": {"type": "boolean"},
    "account_contexts": {"type": "array", "items": {"$ref": "#/$defs/accountContext"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"accountContext": {"type": "object", "additionalProperties": false, "required": ["account_number", "agentic_allowed", "brokerage_account_type", "management_type", "state", "deactivated", "permanently_deactivated"], "properties": {"account_number": {"type": "string"}, "agentic_allowed": {"type": "boolean"}, "brokerage_account_type": {"type": "string"}, "management_type": {"type": "string"}, "state": {"type": "string"}, "deactivated": {"type": "boolean"}, "permanently_deactivated": {"type": "boolean"}}}}
}
