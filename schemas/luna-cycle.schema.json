{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luna Stage-B cycle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "session_date",
    "scanner",
    "timestamp",
    "scanner_total",
    "symbols_processed",
    "finalists",
    "security_status",
    "account_status",
    "tool_call_count",
    "errors",
    "sol_escalation"
  ],
  "properties": {
    "cycle_id": {
      "type": "string"
    },
    "session_date": {
      "type": "string"
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      }
    },
    "timestamp": {
      "type": "string"
    },
    "scanner_total": {
      "type": "integer"
    },
    "symbols_processed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "finalists": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "classification",
          "scanner_percent_change",
          "rvol",
          "gap_return",
          "intraday_return",
          "distance_from_high",
          "distance_from_vwap",
          "vwap",
          "rsi14",
          "ema20",
          "volume_persistence",
          "technical_reason",
          "material_requalification",
          "completed_15m_structure"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "classification": {
            "type": "string",
            "enum": [
              "NEW",
              "MATERIALLY_REQUALIFIED",
              "COOLDOWN",
              "PREVIOUSLY_REJECTED_NO_MATERIAL_CHANGE"
            ]
          },
          "scanner_percent_change": {
            "type": "number"
          },
          "rvol": {
            "type": "number"
          },
          "gap_return": {
            "type": "number"
          },
          "intraday_return": {
            "type": "number"
          },
          "distance_from_high": {
            "type": "number"
          },
          "distance_from_vwap": {
            "type": "number"
          },
          "vwap": {
            "type": "number"
          },
          "rsi14": {
            "type": "number"
          },
          "ema20": {
            "type": "number"
          },
          "volume_persistence": {
            "type": "number"
          },
          "technical_reason": {
            "type": "string"
          },
          "material_requalification": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_type",
                  "evidence",
                  "evidence_timestamp",
                  "new_high_only"
                ],
                "properties": {
                  "event_type": {
                    "type": "string",
                    "enum": [
                      "COMPLETED_BASE_BREAKOUT",
                      "PULLBACK_RECLAIM",
                      "REDUCED_EXTENSION_RENEWED_STRUCTURE",
                      "MATERIALLY_DIFFERENT_PRICE_VOLUME",
                      "NEW_CATALYST"
                    ]
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "evidence_timestamp": {
                    "type": "string"
                  },
                  "new_high_only": {
                    "type": "boolean",
                    "enum": [false]
                  }
                }
              }
            ]
          },
          "completed_15m_structure": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/bar"
            }
          }
        }
      }
    },
    "security_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "robinhood_mcp_available",
        "boundary_ok",
        "forbidden_tools_available"
      ],
      "properties": {
        "robinhood_mcp_available": {
          "type": "boolean"
        },
        "boundary_ok": {
          "type": "boolean"
        },
        "forbidden_tools_available": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "account_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentic_account_count",
        "reconciled",
        "baseline_position_count",
        "baseline_external_order_count",
        "baseline_external_orders_present",
        "baseline_external_orders"
      ],
      "properties": {
        "agentic_account_count": {
          "type": "integer"
        },
        "reconciled": {
          "type": "boolean"
        },
        "baseline_position_count": {
          "type": "integer"
        },
        "baseline_external_order_count": {
          "type": "integer"
        },
        "baseline_external_orders_present": {
          "type": "boolean"
        },
        "baseline_external_orders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "state", "side"],
            "properties": {
              "symbol": {"type": "string"},
              "state": {"type": "string"},
              "side": {"type": "string"}
            }
          }
        }
      }
    },
    "tool_call_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "run_scan"
      ],
      "properties": {
        "total": {
          "type": "integer"
        },
        "run_scan": {
          "type": "integer"
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sol_escalation": {
      "type": "boolean"
    }
  },
  "$defs": {
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "complete"
      ],
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "open": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "close": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "complete": {
          "type": "boolean",
          "enum": [true]
        }
      }
    }
  }
}
