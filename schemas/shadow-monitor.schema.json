{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only Shadow plan market data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "symbol_bars",
    "tool_call_count",
    "errors"
  ],
  "properties": {
    "timestamp": {
      "type": "string"
    },
    "symbol_bars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "bars"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "bars": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/bar"
            }
          }
        }
      }
    },
    "tool_call_count": {
      "type": "integer"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "bar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "complete"
      ],
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "open": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "close": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "complete": {
          "type": "boolean"
        }
      }
    }
  }
}
