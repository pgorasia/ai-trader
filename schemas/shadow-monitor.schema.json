{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only Shadow plan market data",
  "type": "object",
  "additionalProperties": false,
  "required": ["timestamp", "symbol_bars", "tool_call_count", "errors"],
  "properties": {
    "timestamp": {"type": "string", "format": "date-time"},
    "symbol_bars": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"$ref": "#/$defs/bar"}
      }
    },
    "tool_call_count": {"type": "integer", "minimum": 0},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "bar": {
      "type": "object", "additionalProperties": false,
      "required": ["timestamp", "open", "high", "low", "close", "volume", "complete"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "open": {"type": "number", "exclusiveMinimum": 0}, "high": {"type": "number", "exclusiveMinimum": 0},
        "low": {"type": "number", "exclusiveMinimum": 0}, "close": {"type": "number", "exclusiveMinimum": 0},
        "volume": {"type": "number", "minimum": 0}, "complete": {"type": "boolean"}
      }
    }
  }
}
