{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sol senior Shadow decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "decision_timestamp",
    "evaluated_symbols",
    "rejections",
    "symbol",
    "current_price",
    "quote_timestamp",
    "catalyst",
    "catalyst_classification",
    "market_regime",
    "setup_type",
    "entry_trigger",
    "entry_trigger_type",
    "entry_condition",
    "maximum_chase_price",
    "stop_price",
    "stop_basis",
    "target1",
    "target2_optional",
    "hypothetical_notional",
    "hypothetical_quantity",
    "planned_dollar_risk",
    "planned_account_risk_percent",
    "reward_risk_target1",
    "invalidation_condition",
    "time_exit",
    "latest_entry_time",
    "mandatory_flat_time",
    "confidence",
    "robinhood_tool_call_count",
    "web_search_count",
    "errors"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "NO_TRADE",
        "SHADOW_TRADE_PLAN"
      ]
    },
    "decision_timestamp": {
      "type": "string"
    },
    "evaluated_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rejections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "reason",
          "rejection_categories"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "rejection_categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "EXTENSION",
                "NO_OBJECTIVE_ENTRY",
                "INADEQUATE_REWARD_RISK",
                "VOLUME",
                "MARKET_REGIME",
                "CATALYST",
                "EVENT_RISK",
                "LIQUIDITY",
                "TIME_REMAINING",
                "DATA_QUALITY",
                "INELIGIBLE_INSTRUMENT",
                "OTHER"
              ]
            }
          }
        }
      }
    },
    "symbol": {
      "type": [
        "string",
        "null"
      ]
    },
    "current_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "quote_timestamp": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalyst": {
      "type": [
        "string",
        "null"
      ]
    },
    "catalyst_classification": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "VERIFIED_FRESH",
        "RECENT_BUT_STALE",
        "STALE",
        "IMMINENT_EVENT_RISK",
        "UNIDENTIFIED",
        "NONE_REQUIRED_TECHNICAL",
        null
      ]
    },
    "market_regime": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "TRENDING_BULLISH",
        "TRENDING_BEARISH",
        "RANGE_OR_CHOP",
        "HIGH_VOLATILITY_EVENT",
        "UNCERTAIN",
        null
      ]
    },
    "setup_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_trigger": {
      "type": [
        "number",
        "null"
      ]
    },
    "entry_trigger_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "TRADE_AT_OR_ABOVE",
        "COMPLETED_5M_CLOSE_AT_OR_ABOVE",
        null
      ]
    },
    "entry_condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "maximum_chase_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "stop_price": {
      "type": [
        "number",
        "null"
      ]
    },
    "stop_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "target1": {
      "type": [
        "number",
        "null"
      ]
    },
    "target2_optional": {
      "type": [
        "number",
        "null"
      ]
    },
    "hypothetical_notional": {
      "type": [
        "number",
        "null"
      ]
    },
    "hypothetical_quantity": {
      "type": [
        "number",
        "null"
      ]
    },
    "planned_dollar_risk": {
      "type": [
        "number",
        "null"
      ]
    },
    "planned_account_risk_percent": {
      "type": [
        "number",
        "null"
      ]
    },
    "reward_risk_target1": {
      "type": [
        "number",
        "null"
      ]
    },
    "invalidation_condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "time_exit": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_entry_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "mandatory_flat_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "robinhood_tool_call_count": {
      "type": "integer"
    },
    "web_search_count": {
      "type": "integer"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
