  "required": ["passed", "account_classifications", "errors"],
  "properties": {
    "passed": {"type": "boolean"},
    "account_classifications": {"type": "array", "items": {"$ref": "#/$defs/accountClassification"}},
    "errors": {"type": "array", "items": {"type": "string"}}
