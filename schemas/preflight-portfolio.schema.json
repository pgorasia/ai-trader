  "$defs": {"accountClassification": {"type": "object", "additionalProperties": false, "required": ["agentic_allowed", "brokerage_account_type", "management_type", "state", "deactivated", "permanently_deactivated"], "properties": {"agentic_allowed": {"type": "boolean"}, "brokerage_account_type": {"type": "string"}, "management_type": {"type": "string"}, "state": {"type": "string"}, "deactivated": {"type": "boolean"}, "permanently_deactivated": {"type": "boolean"}}}}
