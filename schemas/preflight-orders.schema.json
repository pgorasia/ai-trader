{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SHADOW preflight orders stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["passed", "account_classifications", "account_reconciled", "relevant_order_count", "open_pending_count", "baseline_external_order_count", "baseline_external_orders_present", "baseline_external_orders", "errors"],
  "properties": {
    "passed": {"type": "boolean"},
    "account_classifications": {"type": "array", "items": {"$ref": "#/$defs/accountClassification"}},
    "account_reconciled": {"type": "boolean"},
    "relevant_order_count": {"type": "integer"},
    "open_pending_count": {"type": "integer"},
    "baseline_external_order_count": {"type": "integer"},
    "baseline_external_orders_present": {"type": "boolean"},
    "baseline_external_orders": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["symbol", "state", "side"], "properties": {"symbol": {"type": "string"}, "state": {"type": "string"}, "side": {"type": "string"}}}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"accountClassification": {"type": "object", "additionalProperties": false, "required": ["agentic_allowed", "brokerage_account_type", "management_type", "state", "deactivated", "permanently_deactivated"], "properties": {"agentic_allowed": {"type": "boolean"}, "brokerage_account_type": {"type": "string"}, "management_type": {"type": "string"}, "state": {"type": "string"}, "deactivated": {"type": "boolean"}, "permanently_deactivated": {"type": "boolean"}}}}
}
